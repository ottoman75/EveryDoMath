# EveryDoMath 배포 자동화
#
# 인증은 App Store Connect API 키(.p8)로만 한다. Apple ID 비밀번호를
# 파일이나 환경변수에 두지 않는다. 키는 저장소 밖에 두고 경로만 넘긴다.
#
# 필요한 환경변수 (fastlane/.env.default 또는 셸에서):
#   ASC_KEY_ID      App Store Connect > 사용자 및 액세스 > 통합 에서 발급한 키 ID
#   ASC_ISSUER_ID   같은 화면 상단의 Issuer ID
#   ASC_KEY_PATH    내려받은 AuthKey_XXXX.p8 의 절대 경로

default_platform(:ios)

APP_IDENTIFIER = "kr.co.ottocraft.EveryDoMath"
SCHEME = "EveryDoMath"

platform :ios do

  before_all do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH"),
      in_house: false
    )
  end

  # 앱 레코드 생성 lane 은 두지 않는다.
  #
  # App Store Connect API 는 앱 레코드 생성을 지원하지 않는다. 실제 응답:
  #   The resource 'apps' does not allow 'CREATE'.
  #   Allowed operations are: GET_COLLECTION, GET_INSTANCE, UPDATE
  #
  # fastlane produce 는 API 키가 아니라 Apple ID 웹 세션으로 이 제약을
  # 우회하므로 username/password 가 필요하다. 그래서 여기서는 쓰지 않는다.
  # 앱 레코드는 App Store Connect 웹에서 한 번만 만들면 된다.
  #
  # App ID(Developer 포털) 쪽은 이미 등록돼 있다. Xcode 가 app-store
  # export 시 자동 생성했다: GS7MKDFWW3.kr.co.ottocraft.EveryDoMath

  desc "앱 레코드가 App Store Connect 에 있는지 확인한다"
  lane :check_app do
    require 'spaceship'
    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    if app
      UI.success("앱 레코드 있음 — #{app.name} (Apple ID: #{app.id})")
    else
      UI.user_error!("앱 레코드가 없다. App Store Connect 웹에서 먼저 생성할 것: #{APP_IDENTIFIER}")
    end
  end

  desc "아카이브해서 TestFlight 에 올린다"
  lane :upload do
    # 빌드 번호는 프로젝트 파일을 건드리지 않고 빌드 시점에만 덮어쓴다.
    build_number = Time.now.utc.strftime("%Y%m%d%H%M")

    build_app(
      scheme: SCHEME,
      export_method: "app-store",
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number}",
      output_directory: "build",
      clean: true
    )

    upload_to_testflight(
      app_identifier: APP_IDENTIFIER,
      # 처리 완료까지 기다리지 않는다. 결과는 App Store Connect 에서 본다.
      skip_waiting_for_build_processing: true
    )
  end

  desc "앱 레코드를 확인하고 업로드한다"
  lane :release do
    check_app
    upload
  end
end
