# EveryDoMath 배포 자동화
#
# 인증은 App Store Connect API 키(.p8)로만 한다. Apple ID 비밀번호를
# 파일이나 환경변수에 두지 않는다. 키는 저장소 밖에 두고 경로만 넘긴다.
#
# 필요한 환경변수 (fastlane/.env.default 또는 셸에서):
#   ASC_KEY_ID      App Store Connect > 사용자 및 액세스 > 통합 에서 발급한 키 ID
#   ASC_ISSUER_ID   같은 화면 상단의 Issuer ID
#   ASC_KEY_PATH    내려받은 AuthKey_XXXX.p8 의 절대 경로

default_platform(:ios)

APP_IDENTIFIER = "kr.co.ottocraft.EveryDoMath"
SCHEME = "EveryDoMath"
TEAM_ID = "GS7MKDFWW3"
# fastlane signing 이 만드는 프로파일 이름
PROFILE_NAME = "kr.co.ottocraft.EveryDoMath AppStore"

platform :ios do

  before_all do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH"),
      in_house: false
    )
  end

  # 앱 레코드 생성 lane 은 두지 않는다.
  #
  # App Store Connect API 는 앱 레코드 생성을 지원하지 않는다. 실제 응답:
  #   The resource 'apps' does not allow 'CREATE'.
  #   Allowed operations are: GET_COLLECTION, GET_INSTANCE, UPDATE
  #
  # fastlane produce 는 API 키가 아니라 Apple ID 웹 세션으로 이 제약을
  # 우회하므로 username/password 가 필요하다. 그래서 여기서는 쓰지 않는다.
  # 앱 레코드는 App Store Connect 웹에서 한 번만 만들면 된다.
  #
  # App ID(Developer 포털) 쪽은 이미 등록돼 있다. Xcode 가 app-store
  # export 시 자동 생성했다: GS7MKDFWW3.kr.co.ottocraft.EveryDoMath

  desc "단위 테스트를 돌린다 (UI 테스트 제외)"
  lane :test do
    # EveryDoMathUITests 는 제외한다.
    #   - ScreenshotTests 는 App Store 스크린샷 촬영용 도구다
    #   - UploadPathTests 는 운영 Firestore 에 문서를 실제로 쓴다
    # 둘 다 회귀 테스트가 아니라 수동 실행 도구이므로 기본 실행에서 뺀다.
    run_tests(
      scheme: SCHEME,
      skip_testing: ["EveryDoMathUITests"]
    )
  end

  desc "앱 레코드가 App Store Connect 에 있는지 확인한다"
  lane :check_app do
    require 'spaceship'
    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    if app
      UI.success("앱 레코드 있음 — #{app.name} (Apple ID: #{app.id})")
    else
      UI.user_error!("앱 레코드가 없다. App Store Connect 웹에서 먼저 생성할 것: #{APP_IDENTIFIER}")
    end
  end

  desc "아카이브해서 TestFlight 에 올린다"
  lane :upload do
    # 빌드 번호는 프로젝트 파일을 건드리지 않고 빌드 시점에만 덮어쓴다.
    build_number = Time.now.utc.strftime("%Y%m%d%H%M")

    # 수동 서명으로 고정한다.
    #
    # 자동 서명은 Xcode Accounts 세션에 기대고, 그 세션이 만료될 때마다
    # exportArchive 가 `No signing certificate "iOS Distribution" found` 로
    # 죽었다(이 프로젝트에서 세 번). `fastlane signing` 이 API 키로 받아 둔
    # 인증서와 프로파일을 쓰면 Xcode 로그인이 필요 없다.
    #
    # 프로파일이 없으면 `bundle exec fastlane signing` 을 먼저 돌린다.
    build_app(
      scheme: SCHEME,
      export_method: "app-store",
      # 서명 설정은 xcargs 로 넘기지 않는다. xcargs 는 SPM 패키지 타깃까지
      # 포함한 **모든** 타깃에 적용돼서, 프로파일을 지원하지 않는 nanopb·
      # GoogleUtilities 같은 타깃이 "does not support provisioning profiles"
      # 로 죽는다. 앱 타깃 Release 설정에 직접 넣어 둔다(project.pbxproj).
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number}",
      export_options: {
        signingStyle: "manual",
        teamID: TEAM_ID,
        provisioningProfiles: { APP_IDENTIFIER => PROFILE_NAME }
      },
      output_directory: "build",
      clean: true
    )

    upload_to_testflight(
      app_identifier: APP_IDENTIFIER,
      # 처리 완료까지 기다리지 않는다. 결과는 App Store Connect 에서 본다.
      skip_waiting_for_build_processing: true
    )
  end

  desc "ASC API 키로 배포 인증서와 프로비저닝 프로파일을 발급한다"
  #
  # Xcode Accounts 세션이 만료되면 exportArchive 가
  # `No signing certificate "iOS Distribution" found` 로 죽는다. 배포 인증서가
  # Cloud Managed 라 Xcode 가 Apple 에서 받아와야 하는데, 그 세션이 없으면
  # 받아올 길이 없기 때문이다.
  #
  # 이 레인은 그 의존을 끊는다. API 키로 인증서를 직접 발급해 키체인에 넣고
  # 프로파일을 내려받으므로 Xcode 로그인이 필요 없다.
  #
  # 주의: 배포 인증서는 계정당 3개 한도다. 이미 꽉 찼으면 cert 가 실패하므로
  # 개발자 포털에서 쓰지 않는 것을 먼저 폐기해야 한다.
  lane :signing do
    key = lane_context[SharedValues::APP_STORE_CONNECT_API_KEY]
    cert(api_key: key, output_path: "fastlane/signing")
    sigh(api_key: key,
         app_identifier: APP_IDENTIFIER,
         output_path: "fastlane/signing")
    UI.success("프로파일: #{lane_context[SharedValues::SIGH_PROFILE_PATH]}")
    UI.success("프로파일 이름: #{lane_context[SharedValues::SIGH_NAME]}")
  end

  desc "앱 레코드를 확인하고 업로드한다"
  lane :release do
    check_app
    upload
  end
end
