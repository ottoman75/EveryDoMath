# Xcode 사용자별 설정 — 공유 대상 아님
xcuserdata/
*.xcuserstate

# macOS
.DS_Store

# 빌드 산출물
build/
DerivedData/

# Firebase 설정 — 저장소가 공개라 커밋하지 않는다.
# 클론 후 Firebase 콘솔(프로젝트 everydomath)에서 받아 EveryDoMath/ 아래에 두면 된다.
EveryDoMath/GoogleService-Info.plist

# 하네스 중간 산출물 / 에이전트 설정
_workspace/
# 스킬만 버전 관리한다. 작업 지식이 응축돼 있어 유실되면 복구할 수 없다.
# 디렉터리 자체를 무시(.claude/)하면 하위를 ! 로 되살릴 수 없어 .claude/* 로 쓴다.
.claude/*
!.claude/skills/

# fastlane / bundler
vendor/
.bundle/
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/
fastlane/test_output/
build/

# App Store Connect API 키 — 절대 커밋하지 않는다
*.p8
fastlane/.env*
