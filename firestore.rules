rules_version = '2';

// EveryDoMath Firestore 보안 규칙
//
// 전제: 앱은 Firebase 익명 인증을 사용한다(UserIdentityRepository).
// uid 는 Firebase 가 발급하고 요청마다 토큰으로 증명되므로,
// request.auth.uid 로 신원을 강제할 수 있다.
//
// 콘솔에서 Authentication > Sign-in method > 익명 이 켜져 있어야 한다.
// 꺼져 있으면 로그인이 실패하고 아래 규칙이 모든 쓰기를 거부한다.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // 문서를 소유한 본인인지. 익명 인증 uid 는 위조할 수 없다.
    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // 닉네임은 어린이가 직접 입력한다. 앱에 길이 제한이 없어 여기서 막는다.
    function isSaneNickname(s) {
      return s is string && s.size() >= 1 && s.size() <= 20;
    }

    // ────────────────────────────────────────────────────────────
    // 글로벌 리더보드 — 유저당 문서 1개, 문서 ID = userId
    // ────────────────────────────────────────────────────────────
    match /leaderboard/{userId} {

      function isValidEntry(uid) {
        let d = request.resource.data;
        let fields = ['userId', 'nickname', 'grade', 'score', 'gameGrade', 'correctCount', 'updatedAt'];
        return isSelf(uid)
          && d.userId == uid
          && d.keys().hasOnly(fields)
          && d.keys().hasAll(fields)
          && isSaneNickname(d.nickname)
          && d.grade is int && d.grade >= 1 && d.grade <= 6
          // ScoreCalculator 상한: base 500 + time 300 + combo 200
          && d.score is int && d.score >= 0 && d.score <= 1000
          && d.gameGrade in ['S', 'A', 'B', 'C', 'D']
          // GameSession.problemCount
          && d.correctCount is int && d.correctCount >= 0 && d.correctCount <= 20
          // FieldValue.serverTimestamp() 로 보낸 값만 통과시킨다
          && d.updatedAt == request.time;
      }

      // 앱 안에서는 누구나 보는 랭킹이지만, 앱 밖에서의 무작위 수집은 막는다.
      //   - fetchMyRank 의 순위 집계 쿼리에 limit 이 없어 list 는 제한할 수 없다
      //   - 익명 인증은 API 키만 있으면 누구나 발급받을 수 있어 강한 장벽은
      //     아니다. 다만 규칙 없이 열어 두는 것보다는 낫다
      //   - 닉네임이 다른 사용자에게 보이는 것은 이 기능의 설계 자체다.
      //     어린이 이름 노출 문제는 규칙이 아니라 업로드하는 값을 바꿔서
      //     풀어야 한다 (P0 별건)
      allow read: if isSignedIn();

      allow create: if isValidEntry(userId);

      // 앱은 최고 점수만 유지한다(RemoteLeaderboardRepository 의 트랜잭션).
      // 점수를 깎는 쓰기는 정상 경로에 없으므로 막는다.
      allow update: if isValidEntry(userId)
                    && request.resource.data.score > resource.data.score;

      // 앱에 삭제 경로가 없다. 콘솔에서만 지운다.
      allow delete: if false;
    }

    // ────────────────────────────────────────────────────────────
    // 가족 그룹 — 초대 코드로 참여
    // ────────────────────────────────────────────────────────────
    match /familyGroups/{groupId} {

      function groupFields() {
        return ['id', 'groupCode', 'memberIds', 'memberNames', 'scores', 'createdAt', 'createdBy'];
      }

      function isValidNewGroup() {
        let d = request.resource.data;
        return d.keys().hasOnly(groupFields())
          && d.keys().hasAll(groupFields())
          && d.id == groupId
          // FamilyGroup.generateCode(): 혼동 문자(I, O, 0, 1) 제외 6자리
          && d.groupCode is string
          && d.groupCode.matches('^[A-HJ-NP-Z2-9]{6}$')
          && d.createdAt is timestamp
          && isSelf(d.createdBy)
          // 생성 시점에는 만든 사람 혼자다
          && d.memberIds is list && d.memberIds.size() == 1
          && d.memberIds[0] == d.createdBy
          && d.memberNames is map && d.memberNames.size() == 1
          && d.scores is map && d.scores.size() == 1;
      }

      function isValidGroupUpdate() {
        let d = request.resource.data;
        let p = resource.data;
        // 참여/점수갱신/탈퇴는 멤버 관련 필드만 건드린다. 나머지는 불변이다.
        // 마지막 멤버가 탈퇴하면 맵이 비거나 사라질 수 있어 get(기본값) 으로 읽는다.
        return isSignedIn()
          && d.keys().hasOnly(groupFields())
          && d.id == p.id
          && d.groupCode == p.groupCode
          && d.createdAt == p.createdAt
          && d.createdBy == p.createdBy
          // 가족 단위를 넘어서는 팽창을 막는다
          && d.get('memberIds', []).size() <= 20
          && d.get('memberNames', {}).size() <= 20
          && d.get('scores', {}).size() <= 20;
      }

      // 문서 ID 는 Firestore 자동 생성(20자)이라 추측할 수 없다.
      // fetchLeaderboard(groupId:) 가 쓰는 단건 조회만 허용한다.
      allow get: if isSignedIn();

      // 앱이 날리는 목록 쿼리는 joinGroup 의
      // whereField("groupCode", ==).limit(to: 1) 하나뿐이다.
      // limit 을 1로 묶어 컬렉션 전체 나열(덤프)을 막는다.
      allow list: if isSignedIn() && request.query.limit <= 1;

      allow create: if isValidNewGroup();
      allow update: if isValidGroupUpdate();

      // 탈퇴는 memberIds 에서 제거하는 방식이다. 문서 삭제 경로는 없다.
      allow delete: if false;
    }

    // ────────────────────────────────────────────────────────────
    // 신고 — 부적절한 별명 (심사 가이드라인 1.2)
    // ────────────────────────────────────────────────────────────
    match /reports/{reportId} {

      // 신고 내용은 운영자만 Firebase 콘솔에서 본다.
      // 앱에서 남의 신고를 읽을 이유가 없다.
      allow read: if false;

      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(
             ['reporterId', 'reportedUserId', 'reportedNickname', 'reason', 'createdAt'])
        && request.resource.data.keys().hasAll(
             ['reporterId', 'reportedUserId', 'reportedNickname', 'reason', 'createdAt'])
        // 신고자를 사칭할 수 없다
        && request.resource.data.reporterId == request.auth.uid
        // 자기 자신은 신고할 수 없다
        && request.resource.data.reportedUserId is string
        && request.resource.data.reportedUserId != request.auth.uid
        && isSaneNickname(request.resource.data.reportedNickname)
        && request.resource.data.reason in ['inappropriate_name', 'other']
        && request.resource.data.createdAt == request.time;

      // 한번 남긴 신고는 고치거나 지울 수 없다.
      allow update, delete: if false;
    }

    // 명시하지 않은 경로는 전부 차단한다.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
